# ==============================================================================
# ORBIT AI — ENVIRONMENT VARIABLE CONFIGURATION (.env.example)
# ==============================================================================

# 1. Core Application Settings
APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_API_KEY=change-me-in-production-min-16-chars
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
CORS_ORIGINS=

# 2. Persistence, Storage & Vector Providers
# Allowed DATABASE_PROVIDER: supabase | sqlite
DATABASE_PROVIDER=sqlite
# Allowed STORAGE_PROVIDER: supabase | local
STORAGE_PROVIDER=local
# Allowed VECTOR_PROVIDER: supabase | local | qdrant
VECTOR_PROVIDER=local

# 3. Supabase Configuration (Required when any provider is 'supabase')
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_VECTOR_DIMENSIONS=128

# Optional Qdrant Vector Configuration (When VECTOR_PROVIDER=qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=orbit_knowledge

# 4. LLM Provider Configuration
# Allowed LLM_PROVIDER_TYPE: local | openai-compatible
LLM_PROVIDER_TYPE=local
LLM_PROVIDER_NAME=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_STREAM=false
LLM_CHAT_PATH=/chat/completions
LLM_HEALTH_PATH=/models
LLM_API_KEY_ENV=
LLM_AUTH_HEADER_NAME=Authorization
LLM_AUTH_SCHEME=Bearer
LLM_HEADERS=
LLM_QUERY_PARAMS=

# 5. Embeddings Provider Configuration
# Allowed EMBEDDING_PROVIDER: local | openai-compatible
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=128
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# 6. Notification & Outbox Settings
# Allowed NOTIFICATION_PROVIDER: supabase | smtp | outbox
NOTIFICATION_PROVIDER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@orbit-ai.local

# 7. RAG Ingestion & Retrieval Operational Limits
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=900
CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
DEFAULT_MIN_SIMILARITY=0.25
MAX_MESSAGE_LENGTH=4000
CONVERSATION_HISTORY_LIMIT=10
PUBLIC_RATE_LIMIT_PER_MINUTE=60
ADMIN_RATE_LIMIT_PER_MINUTE=120

# 8. RAG Diagnostics & Legacy Debug Compatibility Flags (Disabled by default)
ORBIT_RAG_DIAGNOSTICS=0
ORBIT_TEMP_DEBUG_CLIENT_ID=
ORBIT_TEMP_DEBUG_GOUSTO=0
ORBIT_TEMP_DEBUG_LLM_INPUT=0
ORBIT_TEMP_DEBUG_PUREGYM=0

# 9. Optional Text-to-Speech (Server-only; disabled unless provider/endpoint/voice set)
TTS_API_KEY=
TTS_PROVIDER=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
